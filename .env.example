# BigBrew Supabase workspace; set on the server, never in public JavaScript.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
BRANCHWORK_ACCESS_KEY=generate-a-long-random-secret
BRANCHWORK_WORKSPACE_ID=main

# Optional legacy Neon connection; Supabase takes precedence when configured.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

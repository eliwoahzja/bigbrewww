# Branchwork live workspace.
# Copy to .env (never commit .env) or set these in Vercel → Settings → Environment Variables.

# Neon Postgres connection string. Neon dashboard → Connection string → pooled.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Shared branch passphrase. Required in live mode; the API refuses every
# request without it, and it must never be exposed to the browser other than
# being typed into the unlock screen by staff.
BRANCHWORK_ACCESS_KEY=replace-with-a-long-random-passphrase

# Optional: row id when one database holds more than one branch workspace.
BRANCHWORK_WORKSPACE_ID=main

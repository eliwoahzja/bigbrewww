{
  "name": "bigbrew-operations-capstone",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Branchwork: a live café shift operations workspace for BigBrew, with Postgres persistence and an offline fallback",
  "scripts": {
    "start": "node server.mjs",
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "qa": "node scripts/ui-qa.mjs",
    "qa:live": "node scripts/live-qa.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "check": "npm test && npm run qa && npm run qa:live"
  },
  "devDependencies": {
    "axe-core": "^4.10.2",
    "playwright": "^1.49.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0"
  }
}
